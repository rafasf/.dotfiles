#!/usr/bin/env bash
# Verify XDG/tool-home vars agree across every place that declares them:
# zsh (zshenv), fish (conf.d/config_dirs.fish), sh (.profile), and the
# launchd session (LaunchAgents/dev.rafasf.xdgenv.plist).
#
# The var list itself isn't hardcoded here -- it's read from the
# xdg-sync:start/end block in zshenv, so adding a var only means
# touching the 4 declaration files, never this script.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
zshenv="$repo_root/configurations/.config/zsh/zshenv"
profile="$repo_root/configurations/.profile"

mapfile -t vars < <(
  sed -n '/# xdg-sync:start/,/# xdg-sync:end/p' "$zshenv" \
    | grep -oE '^export [A-Z_][A-Z0-9_]*=' \
    | sed -E 's/^export ([A-Z_][A-Z0-9_]*)=/\1/'
)

if [ "${#vars[@]}" -eq 0 ]; then
  echo "No vars found between xdg-sync:start/end in $zshenv" >&2
  exit 1
fi

fish_val()    { fish -c "echo \$$1" 2>/dev/null; }
zsh_val()     { zsh -fc "source '$zshenv'; eval echo \\\$$1" 2>/dev/null; }
sh_val()      { sh -c ". '$profile'; eval echo \\\$$1" 2>/dev/null; }
launchd_val() { launchctl getenv "$1" 2>/dev/null || true; }

mismatches=0

for var in "${vars[@]}"; do
  fish_v=$(fish_val "$var")
  zsh_v=$(zsh_val "$var")
  sh_v=$(sh_val "$var")
  launchd_v=$(launchd_val "$var")

  if [ -z "$launchd_v" ]; then
    echo "WARN  $var: launchd has no value (agent not loaded?)"
  fi

  if [ "$zsh_v" = "$fish_v" ] && [ "$sh_v" = "$fish_v" ] \
    && { [ -z "$launchd_v" ] || [ "$launchd_v" = "$fish_v" ]; }; then
    printf 'OK    %-25s %s\n' "$var" "$fish_v"
  else
    mismatches=$((mismatches + 1))
    printf 'DRIFT %-25s fish=%s zsh=%s sh=%s launchd=%s\n' \
      "$var" "$fish_v" "$zsh_v" "$sh_v" "${launchd_v:-<unset>}"
  fi
done

if [ "$mismatches" -gt 0 ]; then
  echo
  echo "$mismatches var(s) out of sync."
  exit 1
fi

echo
echo "All XDG/tool-home vars are in sync."
