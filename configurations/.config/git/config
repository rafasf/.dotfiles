[user]
  name = Rafael Ferreira
  signingKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMeEQn/ygbDKYUberV6orWRHdon7EBDZTJXq5pd+Paum

[include]
  path = ~/.config/git/local.gitconfig

[core]
  excludesfile = ~/.config/git/ignore
  pager = delta
  fsmonitor = true
  untrackedCache = true

[push]
  default = current
  autoSetupRemote = true
  followTags = true

[color]
  ui = auto

[fetch]
  prune = true
  all = true
  writeCommitGraph = true

[transfer]
  fsckObjects = true

[rerere]
  enabled = true
  autoupdate = true

[alias]
  st = status
  df = diff
  dc = diff --cached
  l = log --pretty=easy
  lg = log --pretty=easy --graph

[pretty]
  easy = %C(yellow)%h%C(reset) %G? %<(72,trunc)%s %C(green)(%ar)%C(reset) %an %C(bold blue)%d%C(reset)

[format]
  pretty = easy

[log]
  follow = true

[diff]
  algorithm = histogram
  colorMoved = default
  colorMovedWS = allow-indentation-change
  mnemonicPrefix = true
  renames = copies

[blame]
  coloring = highlightRecent

[branch]
  sort = -committerdate

[tag]
  gpgsign = true
  sort = version:refname

[status]
  showStash = true

[help]
  autocorrect = prompt

[commit]
  gpgsign = true
  verbose = true

[merge]
  conflictstyle = zdiff3
  ff = only

[pull]
  rebase = true

[rebase]
  autoStash = true
  autoSquash = true

[init]
  defaultBranch = main

[filter "lfs"]
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process

[gpg]
  format = ssh

[gpg "ssh"]
  program = ~/.config/git/op-sign
  allowedSignersFile = ~/.config/git/allowed_signers

[interactive]
  diffFilter = delta --color-only --features=interactive

[delta]
  navigate = true

[includeIf "gitdir:~/Projects/tw/"]
  path = ~/Projects/tw/.gitconfig
